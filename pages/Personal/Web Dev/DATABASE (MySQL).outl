      "text": "## LIKE"
    },
    {
      "id": "01M0G9QXDG7TGN3T0V2Y14SNDH",
      "line": 63,
      "indent": 0,
      "content_hash": "sha256:b738e2931396756a4fa2726387aca759367cf8b3625ed5a3f53a59e21f3c5b28",
      "ref_handle": "blk-14sndh",
      "text": "You can select an similar value on tables, using LIKE."
    },
    {
      "id": "01M0G9QXDG9N36TQ4RAH6B1G7K",
      "line": 64,
      "indent": 0,
      "content_hash": "sha256:715a25fc26fe32c8cc2389429f20f8c79bfe2d5d21e3b37daf7492ac210f8df1",
      "ref_handle": "blk-6b1g7k",
      "text": "```SQL"
    },
    {
      "id": "01M0G9QXDG38YXZNMNYD2WW3PN",
      "line": 65,
      "indent": 0,
      "content_hash": "sha256:e4757ca3f926dbdeddb4130508921041f64faebc604553bcebfa9d7313521f31",
      "ref_handle": "blk-2ww3pn",
      "text": "SELECT * FROM TABELA WHERE CAMPO1 LIKE '%MYSQL%'; // ANYTHING WRITTEN AFTER AND BEFORE WILL BE IGNORED, ONLY FOCUSING ON MYSQL APPEARENCES ON EACH FIELDS"
    },
    {
      "id": "01M0G9QXDGWEN450RKVKX4S7JS",
